# Copy this file to .env and fill in your key.
#
#   cp .env.example .env
#
# .env and .env.local are gitignored. This template is the only one committed.

# Required. Your OpenAI API key, from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-6-luna, the cheapest model with native tool calling.
# Any model that supports tool calling works here.
OPENAI_MODEL=gpt-6-luna

# Optional. Pins the date the agent counts deadlines from, in YYYY-MM-DD.
# Leave it empty to use today's real date, which is the normal behaviour.
# Set it to reproduce one of the conversations in examples/, where the
# return and warranty windows were calculated from a specific day.
EMPORIO_TODAY=
